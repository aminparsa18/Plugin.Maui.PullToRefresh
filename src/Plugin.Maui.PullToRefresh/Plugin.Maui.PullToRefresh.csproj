<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android and iOS have real implementations today; that's what's shipped so far. -->
		<TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<PropertyGroup>
		<!-- NuGet package metadata -->
		<PackageId>Plugin.Maui.PullToRefresh</PackageId>
		<Version>0.1.2</Version>
		<Title>Elastic Pull To Refresh for .NET MAUI</Title>
		<Description>A pull-to-refresh control for .NET MAUI with a native, elastic curved-strip animation that tracks the finger 1:1 — no spinner, no RefreshView wrapper. Works over CollectionView, ScrollView, and non-scrollable content on Android and iOS.</Description>
		<PackageTags>maui;pull-to-refresh;refresh;animation;elastic;ios;android</PackageTags>
		<Authors>Amin Parsa</Authors>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<RepositoryUrl>https://github.com/aminparsa18/Plugin.Maui.PullToRefresh</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/aminparsa18/Plugin.Maui.PullToRefresh</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
